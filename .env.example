# ============================================================
# AI批改·错题分析·学情分析系统 —— 环境变量示例
# 复制为 .env 后填写。模型统一走 OpenAI 兼容协议，
# 国内多模态大模型（qwen-vl / GLM-4V / 文心 等）只需替换
# OPENAI_BASE_URL 与 VLM_MODEL，无需改动任何代码。
# ============================================================

# ---- 多模态视觉模型（用于 AI 批改，需支持图片输入） ----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
VLM_MODEL=gpt-4o-mini
# ---- 文本推理模型（错题归因 / 学情报告，可与上同） ----
LLM_MODEL=gpt-4o-mini

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
APP_NAME=Edu Smart Agent

# ---- 数据 ----
# SQLite 数据库文件路径（批改记录 + 错题本 + 学情统计）
DB_PATH=data/edu.db
